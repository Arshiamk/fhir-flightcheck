# Local development only. Use a secret manager outside Docker Compose.
POSTGRES_PASSWORD=replace-with-a-random-local-password
S3_ACCESS_KEY=flightcheck-local
S3_SECRET_KEY=replace-with-a-random-local-secret
FLIGHTCHECK_API_TOKEN=replace-with-at-least-32-random-characters
FLIGHTCHECK_WORKER_TOKEN=replace-with-a-different-32-character-random-value

# Generate with:
# docker compose run --no-deps --rm control-plane generate-signing-key
# Copy the privateKey value only. Never commit the resulting .env file.
FLIGHTCHECK_SIGNING_KEY=replace-with-generated-base64-ed25519-private-key

# Active checks against private or loopback targets are disabled by default in
# standalone deployments. The bundled Compose network enables them only for the
# synthetic HAPI target.
FLIGHTCHECK_ALLOW_LOCAL_DEMO=false

# Optional: connect the web console to a running control-plane instance.
# Server-side variables (preferred — token never sent to the browser):
CONTROL_PLANE_URL=http://localhost:8080
CONTROL_PLANE_TOKEN=same-value-as-FLIGHTCHECK_API_TOKEN
CONTROL_PLANE_PROJECT_ID=project_...
CONTROL_PLANE_RUN_ID=run_...

# S3 artifact storage (optional — requires Garage or compatible object store):
S3_ENDPOINT=http://localhost:3900
S3_BUCKET=flightcheck-artifacts
S3_REGION=garage
